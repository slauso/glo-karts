# Realtime Colyseus Server — Environment Variables
# Copy this to .env and fill in values for production

# Port for the Colyseus WebSocket server (default: 2567)
COLYSEUS_PORT=2567

# CORS origin — set to your frontend domain in production
# Leave empty for open CORS (dev only)
CORS_ORIGIN=https://your-frontend.vercel.app

# Node environment — set to "production" to disable monitor endpoint
NODE_ENV=production
