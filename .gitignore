# Dependencies
frontend/node_modules/
realtime/node_modules/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
# Allow example env files
!.env.example
frontend/.env.example
realtime/.env.example
# Keep .env.production for deployment config
# .env.production.local

# Build directories
frontend/dist/
frontend/build/
.vite/

# Coverage directory
frontend/coverage/
frontend/test-results/
frontend/reports/

# Editor directories and files
.DS_Store
.idea/
.vscode/

# Python artifacts
__pycache__/
*.py[cod]
.venv/
backend/venv/
backend/env/
backend/staticfiles/
*.sqlite3
db.sqlite3

# Generated frontend artifacts
## Allow all required static assets in public
!frontend/public/
## Still ignore havok/ if not needed (remove this line if havok/ is required)
frontend/public/havok/
## Still ignore logs, screenshots, debug, and dev-snapshots
frontend/builder-visual-smoke.png
frontend/snap-verify.png
frontend/.codex-logs/
frontend/.tmp-*
frontend/*-screenshot.png
frontend/scripts/_debug-*
frontend/dev-snapshots/
frontend/playwright-report/
frontend/screenshots/

