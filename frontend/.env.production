# Local production build defaults. Edit this file (or use .env.production.local)
# to point at a deployed backend. Empty / missing falls back to http://localhost:8000.
# Previous default https://twistedkart.koyeb.app is currently unreachable
# (causes lobby + studio menus to stall waiting for failed requests).
VITE_API_URL=http://localhost:8000
VITE_COLYSEUS_URL=ws://localhost:2567
VITE_USE_COLYSEUS=true
