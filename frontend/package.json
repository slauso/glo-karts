{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare:havok": "node scripts/prepare-havok-wasm.mjs",
    "predev": "npm run prepare:havok",
    "prebuild": "npm run prepare:havok",
    "prepreview": "npm run prepare:havok",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:lobby:regression": "node scripts/lobby-ux-regression.mjs",
    "test": "npx playwright test",
    "test:spawn": "npx playwright test tests/01-spawn-sequence.spec.js",
    "test:maps": "npx playwright test tests/02-map-viability.spec.js",
    "test:pvp": "npx playwright test tests/03-pvp-session.spec.js",
    "test:scaling": "npx playwright test tests/04-kart-scaling.spec.js",
    "test:smoke": "npx playwright test tests/phase1-smoke.spec.js",
    "test:full": "npx playwright test && node scripts/apply-map-audit.mjs --dry-run",
    "audit:maps": "npx playwright test tests/02-map-viability.spec.js && node scripts/apply-map-audit.mjs",
    "audit:maps:dryrun": "npx playwright test tests/02-map-viability.spec.js && node scripts/apply-map-audit.mjs --dry-run"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "playwright": "^1.58.2",
    "vite": "^6.2.6"
  },
  "dependencies": {
    "@babylonjs/core": "^8.53.0",
    "@babylonjs/havok": "^1.3.11",
    "@babylonjs/loaders": "^8.53.0",
    "@vercel/analytics": "^1.5.0",
    "cannon-es": "^0.20.0",
    "cannon-es-debugger": "^1.0.0",
    "colyseus.js": "^0.16.22",
    "three": "^0.175.0"
  }
}
